# Copiar a .env y completar. No subir .env al repositorio (está en .gitignore).
# Para el contenedor de SQL Server la contraseña debe tener 8 o más caracteres con mayúsculas, minúsculas, números y símbolos.
ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=CambiarEstaContrasena1!

# Conexión usada al ejecutar la API fuera de Docker (dotnet run, IDE). Docker Compose fija DB_HOST=db por su cuenta.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=TecnoStock

# Puertos publicados en la máquina por Docker Compose.
DB_HOST_PORT=1433
APP_PORT=8080

ASPNETCORE_ENVIRONMENT=Development
