<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\application\TecnoStock.Aplicacion.csproj" />
    <ProjectReference Include="..\domain\TecnoStock.Dominio.csproj" />
    <ProjectReference Include="..\infrastructure\TecnoStock.Infraestructura.csproj" />
  </ItemGroup>

  <!-- Datos semilla del curso (catálogo y clientes). Se copian junto al ejecutable. -->
  <ItemGroup>
    <Content Include="..\..\data\catalogo.csv" Link="datos\catalogo.csv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\actores.csv" Link="datos\actores.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
