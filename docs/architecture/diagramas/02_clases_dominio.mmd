%% ---------- Maquina de estados (ADR-008) ----------
class MaquinaDeEstados~TEstado~ {
  <<State Machine>>
  -Map transicionesPermitidas
  +PuedeTransicionar(desde, hacia) bool
  +Transicionar(actual, destino) TEstado
}

class CriterioDeDevolucion {
  <<Policy>>
  -List~ReglaDeDevolucion~ reglas
  +Evaluar(venta, linea, producto, condicion, ahora) DictamenDeDevolucion
}

